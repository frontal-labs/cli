# Frontal CLI Configuration (environment variables)
# These override config file values but are overridden by CLI flags.

# FRONTAL_API_KEY=frt_your_api_key_here
# FRONTAL_API_URL=https://api.frontal.dev/v1
# FRONTAL_ORG_ID=org_xxx
# FRONTAL_WORKSPACE_ID=ws_xxx
# FRONTAL_PROFILE=default

# ---------------------------------------------------------------------------
# Incident.io Status Page Integration (GitHub Actions secrets & variables)
# These must be set in the repository Settings → Secrets and variables → Actions.
# ---------------------------------------------------------------------------

# === Required Secrets ===

# Incident.io API key with incident_creator + incident_editor roles
# Create at: Incident.io → Settings → API Keys
INCIDENT_IO_API_KEY=

# Frontal API key used by synthetic monitoring for authenticated E2E journeys
FRONTAL_TEST_API_KEY=

# Frontal API base URL for connectivity tests
FRONTAL_TEST_API_URL=https://api.frontal.dev/v1

# === Required Variables ===

# Status page ID from Incident.io (found in Status Pages → your page → URL)
INCIDENT_IO_STATUS_PAGE_ID=

# Severity IDs from Incident.io (found in Settings → Severities)
# Used to classify incidents by scope of journey failures
INCIDENT_IO_SEVERITY_MINOR_ID=
INCIDENT_IO_SEVERITY_MAJOR_ID=

# Component ID for the CLI on the status page (from .github/incident/components.json)
INCIDENT_IO_CLI_COMPONENT_ID=01KSZDH4708FYCMBRJWGANMYYN

# === Optional Variables (defaults shown) ===

# Consecutive failures before creating an incident
MONITOR_FAIL_THRESHOLD=3

# Consecutive successes before auto-resolving an incident
MONITOR_RECOVER_THRESHOLD=2

# Per-journey timeout in seconds during synthetic monitoring
MONITOR_E2E_TIMEOUT_SECS=120
