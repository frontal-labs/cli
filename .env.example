# Frontal CLI Configuration (environment variables)
# These override config file values but are overridden by CLI flags.

# FRONTAL_API_KEY=frt_your_api_key_here
# FRONTAL_API_URL=https://api.frontal.dev/v1
# FRONTAL_ORG_ID=org_xxx
# FRONTAL_WORKSPACE_ID=ws_xxx
# FRONTAL_PROFILE=default

# ---------------------------------------------------------------------------
# Synthetic monitoring (GitHub Actions secrets & variables)
# These must be set in the repository Settings → Secrets and variables → Actions.
# ---------------------------------------------------------------------------

# === Required Secrets ===

# Frontal API key used by synthetic monitoring for authenticated E2E journeys
FRONTAL_TEST_API_KEY=

# Frontal API base URL for connectivity tests
FRONTAL_TEST_API_URL=https://api.frontal.dev/v1

# === Optional Variables (defaults shown) ===

# Per-journey timeout in seconds during synthetic monitoring
MONITOR_E2E_TIMEOUT_SECS=120
