{
  "name": "frontal-cli",
  "version": "0.1.2",
  "description": "Frontal CLI",
  "license": "Apache-2.0",
  "author": "Frontal Labs",
  "homepage": "https://github.com/frontal-labs/cli",
  "bugs": "https://github.com/frontal-labs/cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontal-labs/cli.git"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "frontal": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run bin/frontal.ts",
    "generate:openapi-ops": "node ./scripts/generate-openapi-operations.mjs",
    "validate:bindings": "node ./scripts/validate-command-bindings.mjs",
    "build": "bun run generate:openapi-ops && bun run validate:bindings && tsup && chmod +x dist/index.js",
    "build:binary": "bun build --compile --minify ./bin/frontal.ts --outfile dist/frontal",
    "build:binaries": "bun scripts/build-binaries.ts",
    "build:all": "bun run build && bun run build:binary",
    "test:readme": "bun run build && bun scripts/run-readme-blocks.ts",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "check": "bun run generate:openapi-ops && bun run validate:bindings && ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@frontal-labs/core": "1.0.4",
    "@frontal-labs/sdk": "1.0.4",
    "chalk": "6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "3.0.2",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@frontal-labs/testing": "1.0.4",
    "@types/bun": "^1.3.10",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "9.1.7",
    "tsup": "^8.0.0",
    "typescript": "7.0.2",
    "ultracite": "7.11.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.8"
  },
  "packageManager": "bun@1.3.8"
}
