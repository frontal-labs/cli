#!/usr/bin/env bash
set -euo pipefail

# Tool setup: ensure Bun is available on every agent before any step command
# runs. Stage scripts then source .buildkite/scripts/bootstrap.sh to install
# dependencies from the frozen lockfile.
export BUN_INSTALL="${BUN_INSTALL:-${HOME}/.bun}"
export PATH="${BUN_INSTALL}/bin:${PATH}"

if ! command -v bun >/dev/null 2>&1; then
  echo "--- :bun: Installing Bun ${BUN_VERSION:-1.3.8}"
  BUN_VERSION="${BUN_VERSION:-1.3.8}" curl -fsSL https://bun.sh/install | bash
fi

bun --version
